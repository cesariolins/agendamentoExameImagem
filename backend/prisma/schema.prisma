generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model Exame {
  id             Int           @id
  nome           String
  nomeBusca      String
  duracaoMinutos Int
  agendamentos   Agendamento[]
}

model Medico {
  id           Int           @id
  nome         String
  crm          String        @unique
  turnos       Turno[]
  agendamentos Agendamento[]
}

model Turno {
  id        Int    @id @default(autoincrement())
  medicoId  Int
  diaSemana Int
  inicio    String
  fim       String
  medico    Medico @relation(fields: [medicoId], references: [id])

  @@index([medicoId, diaSemana])
}

enum StatusAgendamento {
  ATIVO
  CANCELADO
}

model Agendamento {
  id           Int               @id @default(autoincrement())
  pacienteNome String
  exameId      Int
  medicoId     Int
  inicio       DateTime
  fim          DateTime
  status       StatusAgendamento @default(ATIVO)
  criadoEm     DateTime          @default(now())
  canceladoEm  DateTime?
  exame        Exame             @relation(fields: [exameId], references: [id])
  medico       Medico            @relation(fields: [medicoId], references: [id])

  @@index([medicoId, inicio])
}
