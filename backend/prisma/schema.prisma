// Modelo de dados do agendamento de exames.
// A regra "sem sobreposição" é garantida por trigger (veja a migration trigger_sem_sobreposicao),
// pois o Prisma não modela restrições de intervalo.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model Exame {
  /// Mesmo id do catálogo (dados/exames.csv)
  id             Int           @id
  nome           String
  /// Nome em minúsculas e sem acentos, para busca ("torax" acha "Tórax")
  nomeBusca      String
  duracaoMinutos Int
  agendamentos   Agendamento[]
}

model Medico {
  id           Int           @id
  nome         String
  crm          String        @unique
  turnos       Turno[]
  agendamentos Agendamento[]
}

model Turno {
  id        Int    @id @default(autoincrement())
  medicoId  Int
  /// 0 = domingo … 6 = sábado
  diaSemana Int
  /// "HH:MM" no horário da clínica
  inicio    String
  fim       String
  medico    Medico @relation(fields: [medicoId], references: [id])

  @@index([medicoId, diaSemana])
}

enum StatusAgendamento {
  ATIVO
  CANCELADO
}

model Agendamento {
  id           Int               @id @default(autoincrement())
  pacienteNome String
  exameId      Int
  medicoId     Int
  /// Instante UTC, gravado como inteiro epoch-ms (veja src/prisma/adapter.ts)
  inicio       DateTime
  /// Derivado: inicio + duração do exame no momento do agendamento
  fim          DateTime
  status       StatusAgendamento @default(ATIVO)
  criadoEm     DateTime          @default(now())
  canceladoEm  DateTime?
  exame        Exame             @relation(fields: [exameId], references: [id])
  medico       Medico            @relation(fields: [medicoId], references: [id])

  @@index([medicoId, inicio])
}
